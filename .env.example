# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
#DATABASE_URL=postgres://planner_user:planner_pass@db:5432/planner_db
POSTGRES_DB=planner_db
POSTGRES_USER=planner_user
POSTGRES_PASSWORD=planner_pass
DB_HOST=db
DB_PORT=5432

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Email
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=mailer@example.com
EMAIL_HOST_PASSWORD=your-password
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@example.com

# Telegram bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=NSKolesnikov_bot
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# Telegram backup bot
TELEGRAM_BACKUP_BOT_TOKEN=your-telegram-backup-bot-token
TELEGRAM_BACKUP_USER_ID=123456789
TELEGRAM_BACKUP_ENABLED=0
TELEGRAM_BACKUP_WITH_STATS=1
TELEGRAM_BACKUP_CRON=0 10 * * *
TELEGRAM_BACKUP_TIMEOUT=300
TELEGRAM_BACKUP_SEND_STATS_MESSAGE=1

# ClickHouse (production: том clickhouse_data смонтирован в backend как /ch_clickhouse_data:ro)
# Если задан CLICKHOUSE_HOST, send_backup / планировщик дополнительно шлют нативный BACKUP в Telegram.
# Локально без ClickHouse оставьте пустым: CLICKHOUSE_HOST=
CLICKHOUSE_HOST=
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
